+/* ---- Repaint implementation -------------------------------------------- */
+
+static void dirty_register(FakeTarget *t)
+{
+    dirty_init();
+    EnterCriticalSection(&g_dirtyLock);
+    bool known = false;
+    for (auto *x : g_dirty) if (x == t) { known = true; break; }
+    if (!known) g_dirty.push_back(t);
+    LeaveCriticalSection(&g_dirtyLock);
+}
+
+static void dirty_unregister(FakeTarget *t)
+{
+    if (!g_dirtyInit) return;
+    EnterCriticalSection(&g_dirtyLock);
+    for (auto it = g_dirty.begin(); it != g_dirty.end(); ++it)
+        if (*it == t) { g_dirty.erase(it); break; }
+    LeaveCriticalSection(&g_dirtyLock);
+}
+
+void FakeTarget::bind_swap(void *swap)
+{
+    dirty_init();
+    EnterCriticalSection(&g_dirtyLock);
+    for (auto *x : g_dirty)
+        if (x != this && x->boundSwap == swap) x->boundSwap = nullptr;
+    LeaveCriticalSection(&g_dirtyLock);
+    if (boundSwap != swap) LOG("bind swap=%p -> hwnd=%p", swap, hwnd);
+    boundSwap = swap;
+}
+
+static void unbind_swap(void *swap)
+{
+    if (!g_dirtyInit) return;
+    EnterCriticalSection(&g_dirtyLock);
+    for (auto *x : g_dirty) if (x->boundSwap == swap) x->boundSwap = nullptr;
+    LeaveCriticalSection(&g_dirtyLock);
+}
+
+static LONG g_presentPushCount = 0;
+static void present_bound(void *swap, ID3D11Texture2D *tex)
+{
+    if (!g_dirtyInit) return;
+    FakeTarget *t = nullptr;
+    EnterCriticalSection(&g_dirtyLock);
+    for (auto *x : g_dirty)
+        if (x->boundSwap == swap && !x->destroyed && x->hwnd) { t = x; t->AddRef(); break; }
+    LeaveCriticalSection(&g_dirtyLock);
+    if (!t) return;
+    t->commit_texture(tex);
+    if ((InterlockedIncrement(&g_presentPushCount) % 300) == 1)
+        LOG("Present->target: %ldx (hwnd=%p)", g_presentPushCount, t->hwnd);
+    t->Release();
+}
+
+/* Write the last frame into the HWND again.
+   Now runs exclusively on the window thread (from within wnd_proc),
+   no longer on the commit thread — so UpdateLayeredWindow/GDI work
+   reliably and without a cross-thread deadlock. */
+void FakeTarget::repaint()
+{
+    if (destroyed || !hwnd || !IsWindow(hwnd)) return;
+
+    /* Frame snapshot under lock (commit_texture can do
+       free/malloc on lastBuf at the same time). */
+    EnterCriticalSection(&frameLock);
+    if (!lastBuf || !lastW || !lastH) { LeaveCriticalSection(&frameLock); return; }
+    UINT w = lastW, h = lastH;
+    size_t sz = (size_t)w * h * 4;
+    BYTE *snap = (BYTE *)malloc(sz);
+    if (snap) memcpy(snap, lastBuf, sz);
+    LeaveCriticalSection(&frameLock);
+    if (!snap) return;
+
+    /* Presentation: parent-DC blit (persists in Wine's window surface). */
+    present_on_hwnd(snap, w, h);
+    free(snap);
+    InterlockedIncrement(&g_repaintCount);
+    if ((g_repaintCount % 200) == 1)
+        LOG("repaint: %ldx (hwnd=%p %ux%u child=%d)", g_repaintCount, hwnd, w, h,
+            (int)((GetWindowLong(hwnd, GWL_STYLE) & WS_CHILD) != 0));
+}
+
+LRESULT CALLBACK FakeTarget::wnd_proc(HWND h, UINT msg, WPARAM wp, LPARAM lp)
+{
+    /* Find the target by HWND (the WndProc is bound per target,
+       but we only get the HWND — so go through the registry). */
+    FakeTarget *self = nullptr;
+    if (msg == WM_PAINT || msg == WM_ERASEBKGND || msg == WM_NCPAINT ||
+        msg == WM_SIZE || msg == WM_WINDOWPOSCHANGED ||
+        msg == WM_CSP_PRESENT || msg == WM_NCDESTROY) {
+        dirty_init();
+        EnterCriticalSection(&g_dirtyLock);
+        for (auto *t : g_dirty) if (t->hwnd == h) { self = t; break; }
+        LeaveCriticalSection(&g_dirtyLock);
+    }
+
+    /* WM_NCDESTROY: the window is being destroyed -> detach the target so that no
+       repaint is started on a dead/recycled HWND any more. */
+    if (msg == WM_NCDESTROY && self) {
+        self->destroyed = true;
+        /* After origProc set the WndProc chain back to the origin. */
+        LRESULT r = self->origProc ? CallWindowProcW(self->origProc, h, msg, wp, lp)
+                                   : DefWindowProcW(h, msg, wp, lp);
+        self->hwnd = nullptr;
+        self->subclassed = false;
+        /* NOT SetWindowLongPtr here — the window is already being torn down. */
+        dirty_unregister(self);
+        return r;
+    }
+
+    LRESULT r = 0;
+    if (self && self->origProc)
+        r = CallWindowProcW(self->origProc, h, msg, wp, lp);
+    else
+        r = DefWindowProcW(h, msg, wp, lp);
+
+    /* Re-blit after the original. On WM_PAINT/ERASEBKGND (redraw), on
+       WM_WINDOWPOSCHANGED/WM_SIZE (resize/move — exactly the action that made
+       the content flicker) and of course on our explicit
+       present message, present the last frame (again). */
+    if (self && (msg == WM_PAINT || msg == WM_ERASEBKGND || msg == WM_NCPAINT ||
+                 msg == WM_WINDOWPOSCHANGED || msg == WM_SIZE ||
+                 msg == WM_CSP_PRESENT)) {
+        if (msg == WM_CSP_PRESENT)
+            InterlockedExchange(&self->presentPending, 0);  /* release the slot */
+        self->repaint();
+    }
+
+    return r;
+}
+
+void FakeTarget::subclass()
+{
+    if (subclassed || !hwnd || destroyed || !IsWindow(hwnd)) return;
+    SetLastError(0);
+    origProc = (WNDPROC)SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)wnd_proc);
+    if (origProc) {
+        subclassed = true;
+        LOG("repaint: subclassed hwnd=%p (orig=%p)", hwnd, origProc);
+    } else {
+        LOG("repaint: subclassing hwnd=%p failed (err=%lu)", hwnd, GetLastError());
+    }
+}
+
+void FakeTarget::unsubclass()
+{
+    if (subclassed && hwnd && origProc) {
+        SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)origProc);
+        subclassed = false;
+    }
+}
+
+/* Maintenance thread: periodically re-blits dirty targets (fallback in case
+   the subclassing does not take effect). Deliberately slow so that it hardly
+   costs any CPU on a still picture — new frames arrive via Commit() anyway. */
+static DWORD WINAPI repaint_thread(LPVOID)
+{
+    for (;;) {
+        /* Fallback: the subclassing (WM_PAINT) handles the normal case.
+           Only follow up rarely here so that it hardly costs CPU. */
+        Sleep(2000);
+        dirty_init();
+        std::vector<FakeTarget *> snapshot;
+        EnterCriticalSection(&g_dirtyLock);
+        snapshot = g_dirty;
+        LeaveCriticalSection(&g_dirtyLock);
+        for (auto *t : snapshot) {
+            if (!t || t->destroyed || !t->hwnd || !IsWindow(t->hwnd)) continue;
+            if (!IsWindowVisible(t->hwnd)) continue;
+            if (IsIconic(t->hwnd)) continue;
+            t->repaint();   /* parent-DC blit is cross-thread ok */
+        }
+    }
+    return 0;
+}
